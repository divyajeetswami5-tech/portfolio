# =========================================================
# Portfolio backend configuration
# Copy this file to ".env" and fill in real values.
# NEVER commit the real .env file.
# =========================================================

# Server
PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed to call the API (CORS).
# In production set this to your deployed site, e.g. https://divyajeet.dev
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,http://localhost:5500

# --- Contact notifications (mock by default) ---
# Generic incoming webhook (Slack / Discord / Make / Zapier). Leave blank to log only.
CONTACT_WEBHOOK_URL=

# Optional: where contact emails would be dispatched (placeholder, not wired to a provider)
CONTACT_TO_EMAIL=divyajeetswami5@gmail.com

# --- Data persistence ---
# Folder for the JSON flat-file store used by the mock data layer.
DATA_DIR=./data
